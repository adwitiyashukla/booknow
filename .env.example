# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# Local docker-compose default. Swap for Neon/Supabase/RDS in production.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://booknow:booknow@localhost:5432/booknow?schema=public"

# ---------------------------------------------------------------------------
# Auth (NextAuth / Auth.js v5)
# Generate a secret with: openssl rand -base64 32
# ---------------------------------------------------------------------------
AUTH_SECRET="replace-me-with-a-32-byte-random-string"
AUTH_TRUST_HOST=true
NEXTAUTH_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Stripe (optional).
# Leave blank to run the built-in simulated payment provider - the whole
# booking flow still works end to end without any Stripe account.
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_ENABLED="false"

# ---------------------------------------------------------------------------
# AI concierge (optional).
# Leave blank to use the deterministic offline NLU + TF-IDF retriever.
# Set ANTHROPIC_API_KEY to upgrade the concierge to an LLM-backed planner.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=""
AI_MODEL="claude-sonnet-4-5"

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
BOOKING_HOLD_MINUTES="15"
