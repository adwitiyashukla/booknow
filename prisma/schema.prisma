generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  GUEST
  STAFF
  ADMIN
}

enum BookingStatus {
  HELD // inventory reserved, awaiting payment, expires automatically
  CONFIRMED // paid
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  EXPIRED
  NO_SHOW
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentProvider {
  STRIPE
  SIMULATED
}

enum BedType {
  KING
  QUEEN
  TWIN
  BUNK
  SOFA
}

enum RoomUnitStatus {
  AVAILABLE
  OUT_OF_SERVICE
  DEEP_CLEAN
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  passwordHash  String?
  role          Role      @default(GUEST)
  image         String?
  phone         String?
  emailVerified DateTime?
  loyaltyTier   String    @default("EXPLORER")
  loyaltyPoints Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  bookings Booking[]
  reviews  Review[]
  accounts Account[]
  sessions Session[]

  @@index([role])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Property {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  tagline     String
  description String
  city        String
  country     String
  latitude    Float
  longitude   Float
  timezone    String  @default("Etc/UTC")
  currency    String  @default("USD")
  heroImage   String
  checkInHour Int     @default(15)
  checkOutHour Int    @default(11)
  starRating  Float   @default(4.8)

  roomTypes RoomType[]
  amenities PropertyAmenity[]
  createdAt DateTime @default(now())
}

model Amenity {
  id       String @id @default(cuid())
  slug     String @unique
  label    String
  icon     String
  category String @default("general")

  properties PropertyAmenity[]
  roomTypes  RoomTypeAmenity[]
}

model PropertyAmenity {
  propertyId String
  amenityId  String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  amenity    Amenity  @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@id([propertyId, amenityId])
}

model RoomTypeAmenity {
  roomTypeId String
  amenityId  String
  roomType   RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  amenity    Amenity  @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@id([roomTypeId, amenityId])
}

model RoomType {
  id            String  @id @default(cuid())
  propertyId    String
  slug          String  @unique
  name          String
  shortPitch    String
  description   String
  baseRateCents Int
  maxAdults     Int     @default(2)
  maxChildren   Int     @default(2)
  sizeSqm       Int
  bedType       BedType @default(KING)
  bedCount      Int     @default(1)
  floorMin      Int     @default(1)
  floorMax      Int     @default(5)
  hasOceanView  Boolean @default(false)
  hasBalcony    Boolean @default(false)
  isAccessible  Boolean @default(false)
  images        String[]
  searchCorpus  String  @default("")

  property   Property          @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  units      RoomUnit[]
  bookings   Booking[]
  ratePlans  RatePlan[]
  rateRules  RateRule[]
  reviews    Review[]
  amenities  RoomTypeAmenity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([propertyId])
  @@index([baseRateCents])
}

model RoomUnit {
  id         String         @id @default(cuid())
  roomTypeId String
  code       String         @unique
  floor      Int
  status     RoomUnitStatus @default(AVAILABLE)
  notes      String?

  roomType RoomType  @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@index([roomTypeId, status])
}

model RatePlan {
  id                String  @id @default(cuid())
  roomTypeId        String
  code              String
  name              String
  description       String
  adjustmentPct     Float   @default(0)
  minNights         Int     @default(1)
  refundable        Boolean @default(true)
  includesBreakfast Boolean @default(false)
  cancellationHours Int     @default(48)

  roomType RoomType  @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@unique([roomTypeId, code])
}

model RateRule {
  id         String   @id @default(cuid())
  roomTypeId String?
  label      String
  startDate  DateTime @db.Date
  endDate    DateTime @db.Date
  multiplier Float    @default(1.0)
  priority   Int      @default(0)

  roomType RoomType? @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)

  @@index([startDate, endDate])
}

model Booking {
  id           String        @id @default(cuid())
  reference    String        @unique
  userId       String?
  roomTypeId   String
  roomUnitId   String?
  ratePlanId   String?
  status       BookingStatus @default(HELD)

  guestName  String
  guestEmail String
  guestPhone String?

  checkIn  DateTime @db.Date
  checkOut DateTime @db.Date
  nights   Int
  adults   Int      @default(2)
  children Int      @default(0)

  subtotalCents Int
  taxesCents    Int
  feesCents     Int
  discountCents Int @default(0)
  totalCents    Int
  currency      String @default("USD")
  priceBreakdown Json

  specialRequests String?
  holdExpiresAt   DateTime?

  marketSegment       String?
  distributionChannel String?
  guestCountry        String?
  mealPlan            String?
  isRepeatGuest       Boolean @default(false)
  specialRequestCount Int     @default(0)
  confirmedAt     DateTime?
  cancelledAt     DateTime?
  cancellationReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  roomType RoomType  @relation(fields: [roomTypeId], references: [id])
  roomUnit RoomUnit? @relation(fields: [roomUnitId], references: [id])
  ratePlan RatePlan? @relation(fields: [ratePlanId], references: [id])
  payments Payment[]
  events   BookingEvent[]
  review   Review?

  @@index([status, checkIn, checkOut])
  @@index([marketSegment])
  @@index([roomTypeId, checkIn, checkOut])
  @@index([userId])
  @@index([holdExpiresAt])
}

model BookingEvent {
  id        String   @id @default(cuid())
  bookingId String
  type      String
  fromState String?
  toState   String?
  actor     String   @default("system")
  metadata  Json?
  createdAt DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, createdAt])
}

model Payment {
  id             String          @id @default(cuid())
  bookingId      String
  provider       PaymentProvider @default(SIMULATED)
  providerRef    String?         @unique
  status         PaymentStatus   @default(PENDING)
  amountCents    Int
  refundedCents  Int             @default(0)
  currency       String          @default("USD")
  failureReason  String?
  idempotencyKey String?         @unique
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
}

model Review {
  id         String   @id @default(cuid())
  bookingId  String   @unique
  userId     String
  roomTypeId String
  rating     Int
  title      String
  body       String
  createdAt  DateTime @default(now())

  booking  Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  roomType RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)

  @@index([roomTypeId])
}

model ConciergeSession {
  id        String   @id @default(cuid())
  userId    String?
  messages  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
